*{

margin:0;

padding:0;

box-sizing:border-box;

font-family:Arial;

}

body{

background:#e8f1ff;

display:flex;

justify-content:center;

padding:40px;

}

.contenedor{

background:white;

width:700px;

padding:30px;

border-radius:20px;

box-shadow:0px 10px 20px rgba(0,0,0,.2);

}

h1{

text-align:center;

margin-bottom:30px;

color:#3d5afe;

}

.formulario{

display:flex;

gap:10px;

flex-wrap:wrap;

margin-bottom:25px;

}

input,select{

padding:10px;

border-radius:8px;

border:1px solid gray;

flex:1;

}

button{

padding:10px 20px;

background:#3d5afe;

color:white;

border:none;

border-radius:8px;

cursor:pointer;

transition:.3s;

}

button:hover{

background:#1a33d6;

}

.tarea{

display:flex;

justify-content:space-between;

align-items:center;

background:#f5f5f5;

padding:15px;

margin-top:15px;

border-left:8px solid #3d5afe;

border-radius:10px;

}

.info{

display:flex;

flex-direction:column;

}

.completa{

text-decoration:line-through;

color:gray;

}

.botones button{

margin-left:8px;

}

.eliminar{

background:red;

}

.completar{

background:green;

}
